{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.metododopai.com"
                }
            ],
            "destination": "/landing/index.html",
            "permanent": false
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "metododopai.com"
                }
            ],
            "destination": "/landing/index.html",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/pmerj",
            "destination": "https://metododopai-pmerj-landing.vercel.app/"
        },
        {
            "source": "/pmerj/:path*",
            "destination": "https://metododopai-pmerj-landing.vercel.app/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}